{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familiarsworkshop",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  // override locally in .env (ENQUIRY_TO=you@gmail.com) to test without emailing the business
  "vars": { "ENQUIRY_TO": "business@familiarsworkshop.com" },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
}
